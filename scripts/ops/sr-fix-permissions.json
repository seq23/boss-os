{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(command -v:*)",
      "Bash(timeout 1800 gh pr checks:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(curl -sS:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git restore:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge origin/main:*)",
      "Bash(git push origin HEAD:*)",
      "Bash(git push -u origin HEAD)",
      "Bash(git rm -r -q --cached --ignore-unmatch node_modules)",
      "Bash(git remote get-url:*)",
      "Bash(git ls-remote:*)",
      "Bash(git tag --points-at:*)",
      "Bash(git reset --hard origin/main)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh repo view:*)",
      "Bash(gh auth status)",
      "Bash(npm run:*)",
      "Bash(npm ci)",
      "Bash(rm package-lock.json)",
      "Bash(land:*)",
      "Bash(bash ~/.boss-os/runtime/scripts/ops/audit-worktree.sh:*)",
      "Bash(grep:*)",
      "Bash(git worktree list:*)",
      "Bash(git remote -v)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git checkout --:*)",
      "Bash(git --version)",
      "Bash(curl -s:*)",
      "Bash(curl -sL:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr diff:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin HEAD --force:*)",
      "Bash(git push origin HEAD -f:*)",
      "Bash(git push origin HEAD --force-with-lease:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:master:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(gh pr merge:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npm run deploy:*)",
      "Bash(rm -rf:*)",
      "Bash(gh secret:*)",
      "Bash(npm run vault:set:*)",
      "Bash(npm run -s vault:set:*)",
      "Bash(gh api:*)",
      "Bash(git push origin HEAD:refs/heads/main:*)",
      "Bash(git push origin HEAD:refs/heads/master:*)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:master)",
      "Bash(git push *:master *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push *:refs/heads/master*)",
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)",
      "mcp__claude-in-chrome"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/bin/command-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
