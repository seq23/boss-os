{
  "_why": "mailbox-sweep.sh's whole permission list: read mail, read the code-name map, write findings.json, read a page in Monique's own Chrome. Gmail is read-only here: no send.",
  "permissions": {
    "allow": [
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "Read(~/.boss-os/contacts/**)",
      "Read(~/.boss-os/mailbox/**)",
      "Edit(~/.boss-os/mailbox/findings.json)",
      "Bash(cd ~/.boss-os/runtime)",
      "Bash(npm run browser:read:*)"
    ],
    "deny": [
      "Agent",
      "Bash(ai-run:*)",
      "Bash(claude:*)",
      "Bash(curl:*)",
      "CronCreate",
      "CronDelete",
      "Edit(~/.boss-os/runtime/**)",
      "Edit(~/.claude/**)",
      "NotebookEdit",
      "RemoteTrigger",
      "ScheduleWakeup",
      "SendMessage",
      "Skill",
      "Task",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "mcp__8raise",
      "mcp__claude-in-chrome",
      "mcp__claude_ai_8Raise",
      "mcp__claude_ai_Claude_Docs",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__delete_draft",
      "mcp__claude_ai_Gmail__delete_label",
      "mcp__claude_ai_Gmail__download_gmail_attachment",
      "mcp__claude_ai_Gmail__forward",
      "mcp__claude_ai_Gmail__mark_message_spam",
      "mcp__claude_ai_Gmail__mark_thread_spam",
      "mcp__claude_ai_Gmail__reply",
