# West Peek OS — names-only environment contract example.
# SECRET VALUES DO NOT BELONG HERE OR IN ANY .env FILE. Use the encrypted vault:
#   npm run vault:init
#   npm run vault:import -- path/to/operator-supplied.env
#   npm run vault:run -- <command>
# See docs/ENVIRONMENT_CONTRACT.md for the full names-only contract.

# Optional additional owner senders for intake (Worker secret and Mac vault/environment).
BOSS_EXTRA_OWNER_SENDERS=

# Non-secret runtime config (local default already set in wrangler.toml):
WP_OS_ENV=local

# Non-secret provider/account config (fill only when the operator provides them):
CLOUDFLARE_ACCOUNT_ID=

# P16/P22/P23 provider and connector credential NAMES (values live in the vault, never here).
# Every one is absent in all current environments, which is why the corresponding capability is
# reported UNPROVEN rather than broken. See docs/ENVIRONMENT_CONTRACT.md.
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
AI_PROVIDER_API_KEY=
HARVEY_API_KEY=
NORM_API_KEY=
NETWORK_OS_API_TOKEN=
CALENDAR_OAUTH_TOKEN=
EMAIL_OAUTH_TOKEN=
TRANSCRIPTION_API_KEY=
VDR_API_KEY=
FUND_ADMIN_SFTP_KEY=

# Boss OS employee mail (Mac launchd jobs via npm run vault:run; values live in the vault).
# BOSS_OS_MAIL_KEY: Boss OS Resend team (sequoiataylor.com) — the primary sender.
# BOSS_OS_FALLBACK_MAIL_KEY: The Industry Guides Resend team (hello@theindustryguides.com), used only
# when the primary is refused. Prefixed rather than reusing RESEND_API_KEY because that name already
# means the West Peek team here (reserved-name rule: a vendor name is prefixed, never given a second meaning).
BOSS_OS_MAIL_KEY=
BOSS_OS_FALLBACK_MAIL_KEY=
