{
  "name": "boss-os",
  "private": true,
  "version": "21.0.0",
  "description": "West Peek OS \u2014 governed institutional operating system (P0-P12 substrate, P13-P25 operating product).",
  "type": "module",
  "scripts": {
    "backup:local": "node scripts/backup/backup.mjs",
    "baseline": "node scripts/baseline.mjs",
    "build": "vite build",
    "deploy:production": "node scripts/deploy/production.mjs",
    "dev": "npm run build && wrangler dev",
    "e2e": "node scripts/e2e/prepare-local.mjs && CI=true npx wrangler d1 migrations apply WP_OS_DB --local && node scripts/e2e/prepare-local.mjs --verify-only && playwright test",
    "migrate:local": "wrangler d1 migrations apply WP_OS_DB --local",
    "ops:shoot-roster": "node scripts/ops/shoot-roster.mjs",
    "ops:workers-ai-usage": "node scripts/ops/workers-ai-usage.mjs",
    "restore:local": "node scripts/backup/restore.mjs",
    "test": "vitest run && vitest run --config vitest.boss.config.ts",
    "test:boss": "vitest run --config vitest.boss.config.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run validate:gmail && npm run validate:reachable && npm run typecheck && npm run test",
    "validate:ai-boundary": "node scripts/validate/no-direct-provider-calls.mjs && node scripts/validate/no-direct-provider-calls.mjs --self-test && node scripts/seed/generate-ai-employee-seed.mjs --check",
    "validate:api-screens": "node scripts/validate/api-has-a-screen.mjs && node scripts/validate/api-has-a-screen.mjs --self-test",
    "validate:authority": "node scripts/validate/no-unauthorized-effects.mjs && node scripts/validate/no-unauthorized-effects.mjs --self-test && node scripts/seed/generate-machine-seed.mjs --check",
    "validate:brand": "node scripts/validate/boss-os-brand-system.mjs && node scripts/validate/boss-os-brand-system.mjs --self-test",
    "validate:classification": "node scripts/validate/data-classification.mjs",
    "validate:css-classes": "node scripts/validate/css-classes.mjs",
    "validate:css-variables": "node scripts/validate/css-variables.mjs",
    "validate:design-tokens": "node scripts/validate/design-tokens.mjs && node scripts/validate/design-tokens.mjs --self-test",
    "validate:lists-speak": "node scripts/validate/lists-speak-while-loading.mjs",
    "validate:network-boundary": "node scripts/validate/no-cross-repo-coupling.mjs && node scripts/validate/no-cross-repo-coupling.mjs --self-test",
    "validate:sql": "node scripts/validate/sql-against-schema.mjs && node scripts/validate/sql-against-schema.mjs --self-test",
    "validate:value-shapes": "node scripts/validate/value-shapes.mjs && node scripts/validate/value-shapes.mjs --self-test",
    "vault:doctor": "node scripts/vault/vault.mjs doctor",
    "vault:import": "node scripts/vault/vault.mjs import",
    "vault:init": "node scripts/vault/vault.mjs init",
    "vault:remove": "node scripts/vault/vault.mjs remove",
    "vault:run": "node scripts/vault/vault.mjs run --",
    "vault:set": "node scripts/vault/vault.mjs set",
    "vault:status": "node scripts/vault/vault.mjs status",
    "vault:sync:cloudflare": "node scripts/vault/vault.mjs sync:cloudflare",
    "validate:gmail": "node scripts/validate/gmail-metadata-only.mjs",
    "holdings": "node scripts/vault/vault.mjs run -- node scripts/ops/holdings-lookup.mjs",
    "lp:sync": "node scripts/vault/vault.mjs run -- node scripts/ops/lp-tracker-sync.mjs",
    "backend:provision": "node scripts/vault/vault.mjs run -- node scripts/ops/provision-backend.mjs",
    "validate:reachable": "node scripts/validate/reachable.mjs",
    "contacts:sync": "node scripts/vault/vault.mjs run -- node scripts/ops/contacts-sync.mjs",
    "spry:heartbeat": "node scripts/ops/spry-heartbeat.mjs",
    "canon:sync": "node scripts/vault/vault.mjs run -- node scripts/ops/canon-sync.mjs",
    "packet:remind": "node scripts/vault/vault.mjs run -- node scripts/ops/packet-remind.mjs",
    "app:install": "bash scripts/ops/install-desktop-app.sh"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.3.0",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "miniflare": "^4.20251014.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.42.0"
  }
}
